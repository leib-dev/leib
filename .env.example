# =====================================================
# LEIB - Variables d'environnement
# Copie ce fichier en ".env" et remplace les valeurs
# par tes vraies clés. Ne commit JAMAIS le fichier ".env"
# =====================================================

# --- APPWRITE (Auth, Base de données, Storage de base) ---
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
EXPO_PUBLIC_APPWRITE_PROJECT=leib_project_id
EXPO_PUBLIC_APPWRITE_DATABASE_ID=leib_db
EXPO_PUBLIC_APPWRITE_COL_USERS=users
EXPO_PUBLIC_APPWRITE_COL_VIDEOS=videos
EXPO_PUBLIC_APPWRITE_COL_TRANSACTIONS=transactions
EXPO_PUBLIC_APPWRITE_COL_LIVES=lives
EXPO_PUBLIC_APPWRITE_COL_CALLS=calls

# --- BUNNY CDN + BUNNY STREAM (vidéos, prioritaire en Afrique) ---
EXPO_PUBLIC_BUNNY_STORAGE_ZONE=leib-storage
EXPO_PUBLIC_BUNNY_STORAGE_KEY=ta_cle_bunny_storage
EXPO_PUBLIC_BUNNY_CDN_URL=https://leib.b-cdn.net
EXPO_PUBLIC_BUNNY_STREAM_LIBRARY_ID=ton_library_id
EXPO_PUBLIC_BUNNY_STREAM_API_KEY=ta_cle_bunny_stream

# --- CLOUDINARY (images + fallback vidéo si Bunny échoue) ---
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=ton_cloud
EXPO_PUBLIC_CLOUDINARY_API_KEY=ta_cle_cloud
EXPO_PUBLIC_CLOUDINARY_API_SECRET=ton_secret
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=leib_unsigned

# --- SEBPAY AFRICA (paiements + retraits) ---
EXPO_PUBLIC_SEBPAY_API_KEY=ta_cle_sebpay
EXPO_PUBLIC_SEBPAY_BASE_URL=https://api.sebpay.africa/v1
EXPO_PUBLIC_SEBPAY_MERCHANT_ID=ton_merchant_id

# --- LIVEKIT (live streaming WebRTC — fonctionne sur mobile ET navigateur) ---
EXPO_PUBLIC_LIVEKIT_URL=wss://ton-projet.livekit.cloud
EXPO_PUBLIC_LIVEKIT_TOKEN_ENDPOINT=https://cloud.appwrite.io/v1/functions/livekit_token/executions

# --- NOTIFICATIONS SMS (Twilio, via Appwrite Function) ---
EXPO_PUBLIC_SMS_ENDPOINT=https://cloud.appwrite.io/v1/functions/sms_notification/executions

# --- NOTIFICATIONS PUSH NATIVES (Expo Notifications, via Appwrite Function) ---
EXPO_PUBLIC_PUSH_ENDPOINT=https://cloud.appwrite.io/v1/functions/push_notification/executions

# --- ADMIN ---
EXPO_PUBLIC_ADMIN_ID=id_admin
